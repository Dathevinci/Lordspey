{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lord Spey",
  "version": "2.2.0",
  "identifier": "com.lordspey.app",
  "build": {
    "beforeDevCommand": "node server.js",
    "devUrl": "http://localhost:8095",
    "beforeBuildCommand": "node scripts/build-web.js",
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lord Spey — Author's Workspace",
        "width": 1280,
        "height": 820,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#08080a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.png",
      "../assets/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "spey"
        ],
        "name": "Lord Spey Project",
        "description": "Lord Spey Author Project Bundle",
        "role": "Editor",
        "mimeType": "application/x-lord-spey"
      }
    ]
  }
}
