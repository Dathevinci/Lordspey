{
  "name": "lord-spey",
  "version": "1.0.0",
  "description": "Minimal Obsidian-inspired author's workspace for drafts, lore, and worldbuilding.",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win --publish never",
    "build:web": "node scripts/build-web.js",
    "cap:sync": "node scripts/build-web.js && npx cap sync android",
    "test": "node scripts/build-web.js && node verify_all.js && node test_suite.js && node test_graph.js && node test_author_features.js && node test_extended_markdown.js && node test_android.js && node test_intro_animation.js && node test_deep_worldbuilding.js && node test_spey_project.js && node test_settings_suite.js && node test_settings_dom.js"
  },
  "keywords": [
    "author",
    "writing",
    "obsidian",
    "markdown",
    "novel",
    "worldbuilding"
  ],
  "author": "Lord Spey",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lordspey.app",
    "productName": "Lord Spey",
    "directories": {
      "output": "dist"
    },
    "fileAssociations": [
      {
        "ext": "spey",
        "name": "Lord Spey Project",
        "description": "Lord Spey Author Project Bundle",
        "role": "Editor",
        "mimeType": "application/x-lord-spey"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "electron-main.js"
    ]
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2"
  }
}
